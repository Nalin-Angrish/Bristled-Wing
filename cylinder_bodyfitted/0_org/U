FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0.01 0 0);

boundaryField
{
    cylinder_cylinder
    {
        type fixedValue;
        value uniform (0 0 0);
    }
    in
    {
        type fixedValue;
        value uniform (0.01 0 0);
    }
    out
    {
        type inletOutlet;
        inletValue uniform (0.01 0 0);
        value uniform (0.01 0 0);
    }
    top
    {
        type inletOutlet;
        inletValue uniform (0.01 0 0);
        value uniform (0.01 0 0);
    }
    bottom
    {
        type inletOutlet;
        inletValue uniform (0.01 0 0);
        value uniform (0.01 0 0);
    }
    frontAndBack
    {
        type empty;
    }
}

