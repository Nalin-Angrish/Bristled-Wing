ymax = 4; // Maximum limits of the y axis
xmax = 10; // Length of region of wake

n_inlet = 40; // Number of divisions of the C-section before the airfoil (as if this many radii cut the sector)

n_vertical = 100; // Number of divisions of the section going away from the airfoil in +-y and -x directions
r_vertical = 1.05; // Progression of the divisions

n_airfoil = 90; // Number of divisions of the airfoil from the leading edge to the trailing edge

n_wake = 100; // Number of divisions of the wake region
r_wake =1.05; // Progression of the wake region