FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "p|pFinal|pcorr"
    {
        solver          CG;
        preconditioner  Cholesky;
        minIter         1;
        maxIter         1000;
        tolerance       1e-7;
        relTol          0.0;
    }
    "U|UFinal"
    {
        solver           BiCGStab;
        preconditioner   ILU0;

        minIter          1;
        maxIter          1000;
        tolerance        1e-08;
        relTol           0;
    }
}

potentialFlow
{
    nNonOrthogonalCorrectors 1;
}

SIMPLE
{
    nNonOrthogonalCorrectors 1;

    pRefPoint (-0.5 0.5 0.005);
    pRefValue 0;
}

PIMPLE
{
    nOuterCorrectors 3;
    nCorrectors     2;
    nNonOrthogonalCorrectors 1;

    residualControl
    {
        U
        {
            tolerance 1e-7;
            relTol    0;
        }
        p
        {
            tolerance 1e-8;
            relTol    0;
        }
    }

    pRefPoint (-0.5 0.5 0.005);
    pRefValue 0;
    checkMeshCourantNo no;
    correctPhi yes;
}

PISO
{
    nNonOrthogonalCorrectors 1;
}

relaxationFactors
{
    equations
    {
        U         0.5;
        UFinal    0.5;
    }
    fields
    {
        p         0.3;
    }
}

